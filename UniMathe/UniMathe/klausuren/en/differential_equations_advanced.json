            "description": "Solve `y' + y = e^x`.",
            "difficulty": "easy",
            "points": 10,
            "solutionSteps": [
                "Step 1: Integrating factor `\\mu(x)=e^{x}`",
                "Step 2: `(e^x y)' = e^{2x}`",
                "Step 3: `y= \\tfrac{1}{2}e^{x} + C e^{-x}`"
            ]
        },
        {
            "id": 3,
            "topic": "Second Order",
            "title": "Homogeneous, constant coefficients",
            "description": "Solve `y'' - 3y' + 2y = 0`.",
            "difficulty": "medium",
            "points": 12,
            "solutionSteps": [
                "Step 1: Characteristic equation `r^2 - 3r + 2=0`",
                "Step 2: Roots `r=1,2`",
                "Step 3: Solution `y(x)=C_1 e^{x} + C_2 e^{2x}`"
            ]
        },
