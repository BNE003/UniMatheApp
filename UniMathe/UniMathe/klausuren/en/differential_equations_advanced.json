            "title": "Separable Equation",
            "description": "Solve `\\frac{dy}{dx} = xy` with `y(0)=2`.",
            "difficulty": "easy",
            "points": 10,
            "solutionSteps": [
                "Step 1: Separate `\\frac{1}{y}dy = x dx`",
                "Step 2: Integrate `\\ln|y| = \\tfrac{x^2}{2} + C`",
                "Step 3: Initial condition `y(0)=2` gives `y=2 e^{x^2/2}`"
            ]
        },
